<script>
jQuery(function($){
   // validated steps function
    function validateStep(step){
		  let isValid = true;

		  // ✅ TEXT / EMAIL / TEXTAREA
		  step.find('input, textarea').each(function(){
			let field = $(this);
			let type = field.attr('type');

			field.removeClass('error');

			// Skip checkbox here
			if(type === 'checkbox') return;

			if(field.closest('.wpcf7-form-control').hasClass('required-field')){
			  let value = field.val().trim();

			  if(!value){
				field.addClass('error');
				isValid = false;
			  }

			  if(type === 'email'){
				let pattern = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
				if(value && !pattern.test(value)){
				  field.addClass('error');
				  isValid = false;
				}
			  }
			}
		  });

		  // ✅ CHECKBOX GROUP (CF7 style)
		  step.find('.wpcf7-checkbox.required-field').each(function(){
			let group = $(this);
			let checked = group.find('input[type="checkbox"]:checked').length;

			group.removeClass('error');

			if(checked === 0){
			  group.addClass('error');
			  isValid = false;
			}
		  });

		  return isValid;
   }

  // next step events 
  $('.next_step').on('click', function(event){
    let current = $(this).closest('.step');
    event.preventDefault(); // Stops the link from following the URL
    if(validateStep(current)){
      current.removeClass('active');
      current.next('.step').addClass('active');
    } else {
      //alert('Please fill all required fields correctly.');
      current.find('.error').first().focus();
    }
  });
  
  //back steps events
  $('.back_step').on('click', function(){
    let current = $(this).closest('.step');

    current.removeClass('active');
    current.prev('.step').addClass('active');
  });
  
  
  
  //this even will show the custom thank you message
	document.addEventListener('wpcf7mailsent', function(event) {

	  if (event.detail.contactFormId == 5022) { // 👈 your form ID
		document.getElementById('product_form_step_success_msg').style.display = 'block';
		 jQuery('.step').removeClass('active');
		 jQuery('.wpcf7-response-output').css('display','none');
		 
		 //change submit button text
		 //jQuery('.wpcf7-submit').text('Submit');
		 //jQuery('.wpcf7-submit').prop('disabled', false);

	  }

	}, false);


	// make popup modal stay when invalid entries submitted
	jQuery(document).on('wpcf7invalid', function(event) {

	  if (event.detail.contactFormId == 5022) { // contact form ID of product interest form

		// Stop other scripts (like Elementor) from closing popup
		event.stopImmediatePropagation();

		// Force popup to stay open
		let popup = jQuery('.elementor-popup-modal');

		if (!popup.is(':visible')) {
		     elementorProFrontend.modules.popup.showPopup({ id: 5023}); // popup id of product interest form
		}
		
		 jQuery('.wpcf7-response-output').css('display','none');
		 
		 //change submit button text
		 //jQuery('.wpcf7-submit').text('Submit');
		 //jQuery('.wpcf7-submit').prop('disabled', false);
		 
	  }

	});


	jQuery(document).on('elementor/popup/show', function () {
	  if (typeof wpcf7 !== 'undefined') {
		document.querySelectorAll('.wpcf7-form').forEach(function(form){
		  wpcf7.init(form);
		});
	  }
	});
	
	
	// close pop from clicking the close link
	jQuery(document).on('click', '#close_product_form', function(e){
	  e.preventDefault();

	  elementorProFrontend.modules.popup.closePopup({
		id: 5023  // popup id of product interest form
	  }, e);
	});

});

jQuery(document).ready(function($){

    var originalText = '';

    // When user clicks submit
    $('.wpcf7 form').on('submit', function(){
        var $btn = $(this).find('input.wpcf7-submit');

        if(originalText === ''){
            originalText = $btn.val(); // store original text once
        }

        $btn.val('Sending...').prop('disabled', true);
		 // fallback reset after 3 seconds
		resetTimer = setTimeout(function () {
			$btn.val(originalText).prop('disabled', false);
		}, 2000);
    });


});


</script>


